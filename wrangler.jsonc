{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odivon-diet",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/OdivonDiet/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
